# NUT device name as configured in ups.conf
UPS_NAME=eaton

# Optional: remote NUT server (upsd). Leave empty to use local upsc.
# UPS_HOST=192.168.1.1

# Web UI
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765
SITE_TITLE=UPS Monitor

# SQLite event log path
# NUT_UI_DB=/data/events.db

# Optional ntfy notifications (leave empty to disable)
# NTFY_URL=https://ntfy.example.com/ups-alerts
# NTFY_USER=
# NTFY_PASS=
# NTFY_TITLE=UPS
