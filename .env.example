# === NUT (required) ===
# UPS name from ups.conf
UPS_NAME=ups
# Leave empty if nut-ui runs on the same host as upsd.
# Set to the upsd host/IP when using Docker or a remote NUT server.
UPS_HOST=

# === Web UI ===
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765
SITE_TITLE=UPS Monitor
# UI defaults (users can still switch in the browser; choice is saved in localStorage)
DEFAULT_LANG=en
DEFAULT_THEME=dark
# UI auto-refresh default: 5 | 10 | 30 | 60 (seconds). Users can change it in the UI.
DEFAULT_REFRESH_SEC=10

# === Data (persistent across app updates) ===
# Host install example: /var/lib/nut-ui/events.db
# Docker: leave as /data/events.db (compose mounts a volume on /data)
NUT_UI_DB=./events.db

# === Notifications language (server-side ntfy / event log) ===
NOTIFY_LANG=en

# === Optional ntfy ===
# NTFY_URL=https://ntfy.example.com/ups-alerts
# NTFY_USER=
# NTFY_PASS=
# NTFY_TITLE=UPS
